{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rupelian Player",
  "mainBinaryName": "rupelian",
  "version": "0.1.0",
  "identifier": "com.webler.rupelian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rupelian Player",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": [11, 11, 12, 255],
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,MediaRouter --renderer-process-limit=1 --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["mp4", "m4v", "webm", "mov", "mkv", "avi", "wmv", "flv", "mpeg", "mpg", "m2ts", "ts", "vob", "ogv", "3gp", "3g2", "asf"],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer"
      }
    ],
    "resources": ["binaries/*", "lib/*", "rupelian_lib.dll", "vcruntime140.dll", "vulkan-1.dll"],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "startMenuFolder": "Rupelian",
        "displayLanguageSelector": false
      }
    }
  }
}
